---
import { getCollection } from 'astro:content';
const posts = await getCollection('posts');
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>siteready example: plain Astro</title>
	</head>
	<body>
		<h1>Welcome</h1>
		<p>A minimal Astro site with no Starlight, used to exercise the plain-Astro fixer.</p>
		<ul>
			{posts.map((post) => (
				<li><a href={`/posts/${post.id.replace(/\.md$/, '')}`}>{post.data.title}</a></li>
			))}
		</ul>
		<p><a href="/about">About</a></p>
	</body>
</html>
