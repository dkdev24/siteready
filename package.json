{
  "name": "siteready",
  "version": "1.11.0",
  "type": "module",
  "description": "Scan a website with agent-readiness scanners (afdocs, Vercel Is Agentic, Ora), get a unified scorecard, auto-fix supported issues (Astro + Starlight, or plain Astro, + Cloudflare Pages; Next.js + Vercel; Jekyll + GitHub Pages), then re-scan and diff against the baseline -- fully local, no live deployment required to verify the loop.",
  "license": "MIT",
  "keywords": [
    "agent-readiness",
    "llms.txt",
    "afdocs",
    "is-agentic",
    "ora",
    "ai-agents",
    "cli",
    "astro",
    "cloudflare-pages",
    "claude-skill"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkdev24/siteready.git"
  },
  "homepage": "https://dkdev24.github.io/siteready/",
  "bugs": {
    "url": "https://github.com/dkdev24/siteready/issues"
  },
  "bin": {
    "siteready": "src/cli.js"
  },
  "files": [
    "src/",
    "scripts/",
    "docs/",
    "SKILL.md",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "scan": "node src/cli.js",
    "enhance": "node src/cli.js enhance",
    "rescan": "node src/cli.js rescan",
    "diff-report": "node src/cli.js diff-report",
    "loop": "node src/cli.js loop",
    "lint": "node scripts/check-syntax.js && node scripts/check-middleware-dedup.js",
    "verify-loop": "node scripts/verify-loop.js",
    "check-scanner-versions": "node scripts/check-scanner-versions.js"
  },
  "engines": {
    "node": ">=18"
  }
}
